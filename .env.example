# Server Configuration
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/college-event-hub
SESSION_SECRET=supersecretcampuscommunitytoken

# AI Service (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemini-2.5-flash:free

# Map Service (Mapbox)
MAPBOX_TOKEN=your_mapbox_public_token_here

# Image Storage (Cloudinary - Optional, falls back to local upload)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_KEY=your_cloudinary_key
CLOUDINARY_SECRET=your_cloudinary_secret

# Email Service (Nodemailer SMTP - Optional, falls back to console log)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
FROM_EMAIL=noreply@collegeeventhub.edu
