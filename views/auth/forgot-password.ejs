<%- include('../layouts/header') %>

<div class="row justify-content-center align-items-center py-5 min-vh-75">
  <div class="col-md-6 col-lg-5">
    <div class="glass-panel p-5">
      <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center p-3 mb-3 rounded-circle bg-warning-glow border border-warning" style="width: 60px; height: 60px;">
          <i class="bi bi-key-fill text-warning fs-3"></i>
        </div>
        <h2 class="fw-bold text-glow">Forgot Password</h2>
        <p class="text-muted">Enter your registered email to receive a password reset link</p>
      </div>

      <form action="/forgot-password" method="POST" autocomplete="off">
        <div class="mb-4">
          <label for="email" class="form-label">Email Address</label>
          <input type="email" class="form-control form-glass" id="email" name="email" placeholder="name@college.edu" required>
        </div>

        <button type="submit" class="btn btn-glow btn-glow-primary w-100 py-3 mb-3">
          <i class="bi bi-envelope-fill me-2"></i>Send Reset Link
        </button>
      </form>

      <div class="text-center mt-4">
        <p class="text-muted mb-0">Remembered your password? <a href="/login" class="text-primary text-decoration-none">Sign In here</a></p>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
