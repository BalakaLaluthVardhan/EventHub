<%- include('../layouts/header') %>

<div class="row justify-content-center align-items-center py-5 min-vh-75">
  <div class="col-md-6 col-lg-5">
    <div class="glass-panel p-5">
      <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center p-3 mb-3 rounded-circle bg-danger-glow border border-danger" style="width: 60px; height: 60px;">
          <i class="bi bi-shield-lock-fill text-danger fs-3"></i>
        </div>
        <h2 class="fw-bold text-glow">Reset Password</h2>
        <p class="text-muted">Enter and confirm your new password below</p>
      </div>

      <form action="/reset-password/<%= token %>" method="POST" autocomplete="off">
        <div class="mb-3">
          <label for="password" class="form-label">New Password</label>
          <input type="password" class="form-control form-glass" id="password" name="password" placeholder="Min 6 characters" required minlength="6">
        </div>

        <div class="mb-4">
          <label for="confirmPassword" class="form-label">Confirm Password</label>
          <input type="password" class="form-control form-glass" id="confirmPassword" name="confirmPassword" placeholder="Repeat new password" required minlength="6">
        </div>

        <button type="submit" class="btn btn-glow btn-glow-primary w-100 py-3 mb-3">
          <i class="bi bi-shield-check me-2"></i>Update Password
        </button>
      </form>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
