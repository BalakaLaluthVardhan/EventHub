<%- include('../layouts/header') %>

<div class="row justify-content-center align-items-center py-5 min-vh-75">
  <div class="col-md-6 col-lg-5">
    <div class="glass-panel p-5">
      <div class="text-center mb-4">
        <div class="d-inline-flex align-items-center justify-content-center p-3 mb-3 rounded-circle bg-primary-glow border border-primary" style="width: 60px; height: 60px;">
          <i class="bi bi-shield-lock-fill text-primary fs-3"></i>
        </div>
        <h2 class="fw-bold text-glow">Sign In</h2>
        <p class="text-muted">Enter your campus credentials to continue</p>
      </div>

      <form action="/login" method="POST" autocomplete="off">
        <div class="mb-3">
          <label for="email" class="form-label">Email Address</label>
          <input type="email" class="form-control form-glass" id="email" name="email" placeholder="name@college.edu" required>
        </div>
        
        <div class="mb-4">
          <div class="d-flex justify-content-between align-items-center mb-2">
            <label for="password" class="form-label mb-0">Password</label>
            <a href="/forgot-password" class="text-primary text-decoration-none" style="font-size: 0.85rem;">Forgot Password?</a>
          </div>
          <input type="password" class="form-control form-glass" id="password" name="password" placeholder="••••••••" required>
        </div>

        <button type="submit" class="btn btn-glow btn-glow-primary w-100 py-3 mb-3">
          <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
        </button>

        <div class="text-center my-3 text-muted">or</div>

        <a href="/auth/google" class="btn btn-glass-social btn-google w-100 py-3 d-flex align-items-center justify-content-center gap-2">
          <i class="bi bi-google"></i> Sign In with Google
        </a>
      </form>

      <div class="text-center mt-4">
        <p class="text-muted mb-0">Don't have an account? <a href="/register" class="text-primary text-decoration-none">Sign Up here</a></p>
      </div>
    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
