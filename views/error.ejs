<%- include('layouts/header') %>

<div class="row justify-content-center align-items-center py-5 min-vh-75">
  <div class="col-md-8 col-lg-6">
    <div class="glass-panel p-5 text-center border-danger">
      <div class="d-inline-flex align-items-center justify-content-center p-3 mb-3 rounded-circle bg-danger bg-opacity-10 border border-danger" style="width: 70px; height: 70px;">
        <i class="bi bi-exclamation-triangle-fill text-danger fs-1"></i>
      </div>
      
      <h2 class="fw-bold text-glow text-danger mb-2">System Alert</h2>
      <h5 class="fw-semibold mb-4" style="color: var(--text-main); line-height: 1.6;"><%= err.message %></h5>
      
      <% if (typeof isDbTimeout !== 'undefined' && isDbTimeout) { %>
        <div class="text-start alert alert-warning mb-4 p-3 rounded" style="background: rgba(242, 166, 90, 0.15); border: 1px solid var(--warning); color: var(--text-main); font-size: 0.9rem;">
          <div class="fw-bold mb-2 text-warning"><i class="bi bi-gear-fill me-1"></i> Quick Fix for Render / MongoDB Atlas:</div>
          <ol class="mb-0 ps-3">
            <li class="mb-1"><strong>MongoDB Atlas &rarr; Network Access:</strong> Make sure <code>0.0.0.0/0</code> (Allow Access from Anywhere) is added to your IP Access List.</li>
            <li class="mb-1"><strong>Render Dashboard &rarr; Environment:</strong> Ensure <code>MONGODB_URI</code> is added with your MongoDB Atlas connection string.</li>
            <li><strong>Check Database Credentials:</strong> Verify your username, password (special characters must be URL-encoded), and ensure the database cluster is active.</li>
          </ol>
        </div>
      <% } %>

      <% if (process.env.NODE_ENV !== 'production' && err.stack) { %>
        <div class="text-start bg-dark bg-opacity-75 p-3 rounded border border-secondary mb-4 overflow-auto" style="max-height: 250px; font-family: monospace; font-size: 0.8rem; color: #f43f5e; white-space: pre-wrap;">
          <%= err.stack %>
        </div>
      <% } %>

      <a href="/" class="btn btn-glow btn-glow-primary px-4 py-2.5">
        <i class="bi bi-house-door-fill me-2"></i>Return to Home
      </a>
    </div>
  </div>
</div>

<%- include('layouts/footer') %>
