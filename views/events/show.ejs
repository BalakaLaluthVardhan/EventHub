<%- include('../layouts/header') %>

<div class="row g-4 mb-5">
  <!-- Poster Carousel / Grid (Left side) -->
  <div class="col-lg-7">
    <div class="glass-panel p-3 mb-4">
      <!-- Single poster display -->
      <% const posterUrl = event.poster || '/images/default-poster.svg'; %>
      <% if (posterUrl !== '/images/default-poster.svg') { %>
        <img src="<%= posterUrl %>" class="img-fluid w-100 poster-carousel-img" alt="<%= event.title %> poster">
      <% } else { %>
        <!-- Gradient placeholder -->
        <svg class="img-fluid w-100 poster-carousel-img" viewBox="0 0 800 450" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="grad-show-<%= event._id %>" x1="0%" y1="0%" x2="100%" y2="100%">
              <stop offset="0%" style="stop-color:#0f172a;stop-opacity:1" />
              <stop offset="100%" style="stop-color:#6366f1;stop-opacity:0.25" />
            </linearGradient>
          </defs>
          <rect width="100%" height="100%" fill="url(#grad-show-<%= event._id %>)" />
          <text x="50%" y="50%" dominant-baseline="middle" text-anchor="middle" fill="#818cf8" font-size="2rem" font-family="'Outfit', sans-serif" font-weight="800">
            <%= event.title %>
          </text>
        </svg>
      <% } %>
    </div>

    <!-- Event Description -->
    <div class="glass-panel p-4 mb-4">
      <h3 class="fw-bold text-glow mb-3">Event Details</h3>
      <div class="text-muted leading-relaxed markdown-body" style="font-size: 1rem;"><%- parseMarkdown(event.description) %></div>
    </div>
  </div>

  <!-- Booking and Metadata Panel (Right side) -->
  <div class="col-lg-5">
    <!-- Action panel -->
    <div class="glass-panel p-4 mb-4">
      <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
          <span class="badge badge-neon badge-neon-info mb-2 text-uppercase"><%= event.category %></span>
          <h2 class="fw-bold mb-0 text-glow fs-3"><%= event.title %></h2>
        </div>
        
        <!-- Wishlist Button -->
        <% if (currentUser && currentUser.role === 'student') { %>
          <button id="wishlist-btn" data-event-id="<%= event._id %>" class="btn btn-outline-secondary btn-glow rounded-circle p-2 d-flex align-items-center justify-content-center <%= isWishlisted ? 'wishlist-btn-active' : '' %>" style="width: 45px; height: 45px;">
            <i class="bi <%= isWishlisted ? 'bi-heart-fill' : 'bi-heart' %> fs-5"></i>
          </button>
        <% } %>
      </div>

      <div class="mb-4">
        <div class="d-flex align-items-center gap-2 mb-2 text-muted">
          <i class="bi bi-calendar3 text-primary"></i>
          <span><%= event.formattedDate %></span>
        </div>
        <div class="d-flex align-items-center gap-2 mb-2 text-muted">
          <i class="bi bi-clock text-primary"></i>
          <span><%= event.time %></span>
        </div>
        <div class="d-flex align-items-center gap-2 mb-2 text-muted">
          <i class="bi bi-geo-alt text-primary"></i>
          <span><%= event.venue %></span>
        </div>
        <div class="d-flex align-items-center gap-2 text-muted">
          <i class="bi bi-person text-primary"></i>
          <span>Hosted by: <strong><%= event.organizer.name %></strong></span>
        </div>
      </div>

      <div class="row g-2 text-center mb-4 border-top border-bottom border-secondary py-3">
        <div class="col-6 border-end border-secondary">
          <span class="d-block text-muted small uppercase">Admission</span>
          <span class="fs-4 fw-bold text-glow text-success">
            <%= event.price === 0 ? 'FREE' : `₹${event.price}` %>
          </span>
        </div>
        <div class="col-6">
          <span class="d-block text-muted small uppercase">Registrations</span>
          <span class="fs-4 fw-bold text-glow">
            <%= event.registrationCount %> / <%= event.capacity %>
          </span>
        </div>
      </div>

      <!-- User registration action buttons -->
      <div class="mb-4">
        <% if (!currentUser) { %>
          <a href="/login" class="btn btn-glow btn-glow-primary w-100 py-3">
            <i class="bi bi-box-arrow-in-right me-2"></i>Sign In to Register
          </a>
        <% } else { %>
          <% if (currentUser.role === 'student') { %>
            <% if (registrationStatus === 'registered') { %>
              <div class="alert alert-success bg-secondary-glow text-success text-center border-success mb-3">
                <i class="bi bi-patch-check-fill me-2"></i>You are registered for this event!
              </div>
              <form action="/events/<%= event._id %>/cancel" method="POST">
                <button type="submit" class="btn btn-glow btn-outline-danger w-100 py-2.5">
                  <i class="bi bi-x-circle me-2"></i>Cancel Registration
                </button>
              </form>
            <% } else if (registrationStatus === 'waitlisted') { %>
              <div class="alert alert-warning bg-opacity-10 text-warning text-center border-warning mb-3">
                <i class="bi bi-hourglass-split me-2"></i>You are on the Waitlist
              </div>
              <form action="/events/<%= event._id %>/cancel" method="POST">
                <button type="submit" class="btn btn-glow btn-outline-danger w-100 py-2.5">
                  <i class="bi bi-x-circle me-2"></i>Leave Waitlist
                </button>
              </form>
            <% } else if (registrationStatus === 'attended') { %>
              <div class="alert alert-success bg-success text-white text-center mb-0">
                <i class="bi bi-star-fill me-2"></i>You attended this event!
              </div>
            <% } else { %>
              <!-- Show booking triggers -->
              <% if (event.status === 'open') { %>
                <form action="/events/<%= event._id %>/register" method="POST">
                  <% if (event.registrationCount >= event.capacity) { %>
                    <button type="submit" class="btn btn-glow btn-glow-primary w-100 py-3 text-warning">
                      <i class="bi bi-hourglass-split me-2"></i>Join Waitlist (Event Full)
                    </button>
                  <% } else { %>
                    <button type="submit" class="btn btn-glow btn-glow-primary w-100 py-3">
                      <i class="bi bi-ticket-perforated-fill me-2"></i>Register for Event
                    </button>
                  <% } %>
                </form>
              <% } else { %>
                <button class="btn btn-secondary w-100 py-3" disabled>
                  Registrations Closed (<%= event.status.toUpperCase() %>)
                </button>
              <% } %>
            <% } %>
          <% } else if (currentUser._id.equals(event.organizer._id) || currentUser.role === 'admin') { %>
            <!-- Organizer tools -->
            <div class="d-grid gap-2">
              <a href="/dashboard/events/<%= event._id %>/registrations" class="btn btn-glow btn-glow-primary py-2.5">
                <i class="bi bi-people-fill me-2"></i>Manage Attendance
              </a>
              <div class="row g-2">
                <div class="col-6">
                  <a href="/events/<%= event._id %>/edit" class="btn btn-glow btn-glow-secondary w-100 py-2">
                    <i class="bi bi-pencil-square me-2"></i>Edit
                  </a>
                </div>
                <div class="col-6">
                  <form action="/events/<%= event._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to delete this event? This cannot be undone.');">
                    <button type="submit" class="btn btn-glow btn-outline-danger w-100 py-2">
                      <i class="bi bi-trash3 me-2"></i>Delete
                    </button>
                  </form>
                </div>
              </div>
            </div>
          <% } %>
        <% } %>
      </div>

      <!-- Calendar Sync triggers -->
      <div class="border-top border-secondary pt-3">
        <h6 class="text-muted small uppercase mb-2">Sync Calendar</h6>
        <div class="d-flex gap-2 flex-wrap">
          <a href="/events/<%= event._id %>/ics" class="btn btn-sm btn-glow btn-glow-secondary py-2 flex-grow-1">
            <i class="bi bi-file-earmark-calendar me-1"></i>Apple / Outlook (.ics)
          </a>
          <a href="<%= googleCalUrl %>" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-glow btn-glow-secondary py-2 flex-grow-1">
            <i class="bi bi-google me-1"></i>Google Calendar
          </a>
        </div>
      </div>
    </div>

    <!-- AI Review Summary Box -->
    <div class="glass-panel p-4 mb-4">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="fw-bold text-glow mb-0">
          <i class="bi bi-robot text-primary me-2"></i>AI Feedback Summary
        </h4>
        <% if (currentUser && (currentUser._id.equals(event.organizer._id) || currentUser.role === 'admin') && reviews.length > 0) { %>
          <button id="ai-summarize-reviews-btn" data-event-id="<%= event._id %>" class="btn btn-sm btn-glow btn-glow-primary">
            <span id="ai-summary-loader" class="spinner-border spinner-border-sm me-1 d-none" role="status" aria-hidden="true"></span>
            Regenerate
          </button>
        <% } %>
      </div>

      <div id="ai-summary-container" class="bg-dark bg-opacity-25 rounded p-3 border border-secondary">
        <p id="ai-summary-text" class="text-muted mb-0 font-italic" style="font-size: 0.95rem; line-height: 1.6;">
          <%= event.reviewSummary || 'AI Review Summary is generated once feedback reviews are submitted by attendees.' %>
        </p>
      </div>
    </div>

    <!-- Venue Map Panel -->
    <div class="glass-panel p-3">
      <h5 class="fw-bold text-glow mb-2"><i class="bi bi-map-fill me-2"></i>Event Location Map</h5>
      <p class="text-white fw-semibold mb-1"><i class="bi bi-geo-alt-fill me-1 text-primary"></i><%= event.venue %></p>
      <% if (event.address) { %>
        <p class="text-muted small mb-2 ms-4"><%= event.address %></p>
      <% } %>
      
      <!-- Interactive coordinates canvas -->
      <div id="map" 
           data-lat="<%= event.coordinates.lat %>" 
           data-lng="<%= event.coordinates.lng %>" 
           data-venue="<%= event.venue %>"
           data-token="<%= process.env.MAPBOX_TOKEN || '' %>">
      </div>
    </div>
  </div>
</div>

<!-- Reviews section -->
<div class="row mt-4">
  <div class="col-12">
    <div class="glass-panel p-4">
      <h3 class="fw-bold text-glow mb-4"><i class="bi bi-chat-left-heart me-2"></i>Attendee Reviews</h3>

      <div class="row">
        <!-- Review Submission (Student who attended event) -->
        <div class="col-lg-5 mb-4">
          <div class="glass-panel p-4 h-100" style="background: rgba(255, 255, 255, 0.45);">
            <h5 class="fw-bold text-glow mb-2">Leave Feedback</h5>
            
            <% if (currentUser && registrationStatus === 'attended') { %>
              <!-- Show form -->
              <form id="review-form" action="/events/<%= event._id %>/reviews" method="POST">
                <div class="mb-3">
                  <label class="form-label d-block mb-0">Event Rating</label>
                  <div class="star-rating">
                    <input type="radio" id="star5" name="review[rating]" value="5" /><label for="star5" title="5 stars"><i class="bi bi-star-fill"></i></label>
                    <input type="radio" id="star4" name="review[rating]" value="4" /><label for="star4" title="4 stars"><i class="bi bi-star-fill"></i></label>
                    <input type="radio" id="star3" name="review[rating]" value="3" /><label for="star3" title="3 stars"><i class="bi bi-star-fill"></i></label>
                    <input type="radio" id="star2" name="review[rating]" value="2" /><label for="star2" title="2 stars"><i class="bi bi-star-fill"></i></label>
                    <input type="radio" id="star1" name="review[rating]" value="1" /><label for="star1" title="1 star"><i class="bi bi-star-fill"></i></label>
                  </div>
                </div>

                <div class="mb-3">
                  <label for="review-comment" class="form-label">Review Comment</label>
                  <textarea class="form-control form-glass" id="review-comment" name="review[comment]" rows="4" placeholder="Share your experience (seating, speaker sessions, content...)" required></textarea>
                </div>

                <div id="review-error" class="alert alert-danger d-none mb-3 py-2 px-3 small"></div>

                <button type="submit" class="btn btn-glow btn-glow-primary w-100">Publish Review</button>
              </form>
            <% } else if (currentUser && registrationStatus === 'registered') { %>
              <p class="text-muted">You can write a review once the organizer marks your attendance status as **Attended** after the event concludes.</p>
            <% } else { %>
              <p class="text-muted">Only registered student participants marked as **Attended** by the event organizer are eligible to publish reviews.</p>
            <% } %>
          </div>
        </div>

        <!-- Feed list -->
        <div class="col-lg-7">
          <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-glow mb-0">Attendee Review Feed</h5>
            <span class="badge bg-secondary-glow text-muted border border-secondary">
              ⭐ <%= avgRating %> Average Rating (<%= reviews.length %> Reviews)
            </span>
          </div>

          <% if (reviews.length === 0) { %>
            <div class="text-center py-4 bg-secondary-glow rounded border border-secondary">
              <p class="text-muted mb-0">No reviews published yet for this event.</p>
            </div>
          <% } else { %>
            <div class="d-flex flex-column gap-3" style="max-height: 400px; overflow-y: auto; padding-right: 5px;">
              <% reviews.forEach(review => { %>
                <div class="glass-panel p-3 border border-secondary" style="background: rgba(255, 255, 255, 0.55);">
                  <div class="d-flex justify-content-between mb-2">
                    <div>
                      <strong class="text-dark fw-semibold"><%= review.user ? review.user.name : 'Unknown Student' %></strong>
                      <div class="text-warning small d-inline-block ms-2">
                        <% for (let i = 1; i <= 5; i++) { %>
                          <i class="bi <%= i <= review.rating ? 'bi-star-fill' : 'bi-star' %>"></i>
                        <% } %>
                      </div>
                    </div>
                    
                    <% if (currentUser && (currentUser._id.equals(review.user._id) || currentUser.role === 'admin')) { %>
                      <form action="/events/<%= event._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
                        <button type="submit" class="btn btn-link text-danger p-0 m-0 border-0" title="Delete Review">
                          <i class="bi bi-trash-fill"></i>
                        </button>
                      </form>
                    <% } %>
                  </div>
                  <p class="text-main small mb-0 text-break" style="line-height: 1.5;"><%= review.comment %></p>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>

    </div>
  </div>
</div>

<%- include('../layouts/footer') %>
