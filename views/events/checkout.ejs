<%- include('../layouts/header') %>

<div class="row justify-content-center align-items-center py-4">
  <div class="col-xl-9 col-lg-10">
    <div class="glass-panel p-5">
      <div class="text-center mb-5">
        <div class="d-inline-flex align-items-center justify-content-center p-3 mb-3 rounded-circle bg-success-glow border border-success" style="width: 60px; height: 60px;">
          <i class="bi bi-shield-check text-success fs-3"></i>
        </div>
        <h2 class="fw-bold text-glow">Secure Checkout</h2>
        <p class="text-muted">Simulated payment process to confirm your seat registration</p>
      </div>

      <div class="row g-5">
        <!-- Billing Details Form -->
        <div class="col-md-7">
          <h4 class="fw-bold text-glow mb-4">
            <i class="bi bi-credit-card-2-front text-primary me-2"></i>Payment Details
          </h4>

          <form id="payment-form" action="/events/<%= event._id %>/checkout" method="POST" autocomplete="off">
            <div class="mb-4">
              <label for="cardholderName" class="form-label">Cardholder Name</label>
              <input type="text" class="form-control form-glass py-2.5" id="cardholderName" name="cardholderName" placeholder="John Doe" required minlength="3">
            </div>

            <div class="mb-4">
              <label for="cardNumber" class="form-label">Card Number</label>
              <div class="input-group">
                <span class="input-group-text form-glass border-end-0 text-muted"><i class="bi bi-credit-card"></i></span>
                <input type="text" class="form-control form-glass border-start-0 py-2.5" id="cardNumber" name="cardNumber" placeholder="xxxx xxxx xxxx xxxx" required pattern="\d{4} \d{4} \d{4} \d{4}" title="Must be a 16-digit card number" maxlength="19">
              </div>
            </div>

            <div class="row g-3 mb-4">
              <div class="col-6">
                <label for="cardExpiry" class="form-label">Expiration Date</label>
                <input type="text" class="form-control form-glass py-2.5" id="cardExpiry" name="cardExpiry" placeholder="MM/YY" required pattern="(0[1-9]|1[0-2])\/?([0-9]{2})" title="Must be a valid MM/YY expiration date" maxlength="5">
              </div>
              <div class="col-6">
                <label for="cardCvv" class="form-label">CVV / CVC</label>
                <input type="password" class="form-control form-glass py-2.5" id="cardCvv" name="cardCvv" placeholder="123" required pattern="\d{3}" title="Must be a 3-digit security code" maxlength="3">
              </div>
            </div>

            <!-- Visual Simulated Card Preview -->
            <div class="credit-card-preview mb-4 position-relative overflow-hidden text-white rounded-4 p-4 shadow-lg" style="background: linear-gradient(135deg, rgba(30, 41, 59, 0.9), rgba(99, 102, 241, 0.35)); border: 1px solid rgba(255, 255, 255, 0.15); height: 200px;">
              <div class="d-flex justify-content-between align-items-start mb-4">
                <span class="fs-5 fw-bold font-monospace">EVENT CARD</span>
                <i class="bi bi-wifi fs-3 text-secondary"></i>
              </div>
              <!-- Chip simulator -->
              <div class="bg-warning bg-opacity-75 rounded-2 mb-3" style="width: 40px; height: 30px;"></div>
              
              <div class="fs-4 fw-bold font-monospace tracking-wide mb-3 text-shadow" id="preview-card-number">•••• •••• •••• ••••</div>
              <div class="d-flex justify-content-between align-items-center">
                <div>
                  <span class="d-block small text-secondary" style="font-size: 0.65rem;">CARDHOLDER</span>
                  <span class="font-monospace text-uppercase" id="preview-cardholder">JOHN DOE</span>
                </div>
                <div class="text-end">
                  <span class="d-block small text-secondary" style="font-size: 0.65rem;">EXPIRES</span>
                  <span class="font-monospace" id="preview-expiry">MM/YY</span>
                </div>
              </div>
            </div>

            <!-- Submit Button with Spinner -->
            <button type="submit" id="pay-btn" class="btn btn-glow btn-glow-success w-100 py-3 d-flex align-items-center justify-content-center gap-2">
              <span id="spinner-loader" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
              <span id="pay-btn-text"><i class="bi bi-lock-fill me-1"></i>Pay & Confirm Registration</span>
            </button>
          </form>
        </div>

        <!-- Order Summary Column -->
        <div class="col-md-5">
          <div class="card bg-dark bg-opacity-40 border-secondary p-4 h-100">
            <h4 class="fw-bold text-glow mb-4">Order Summary</h4>
            
            <div class="pb-3 border-bottom border-secondary mb-3">
              <span class="badge badge-neon badge-neon-info text-uppercase mb-2"><%= event.category %></span>
              <h5 class="fw-bold text-white mb-1"><%= event.title %></h5>
              <p class="text-muted small mb-0"><i class="bi bi-geo-alt me-1"></i><%= event.venue %></p>
              <p class="text-muted small mb-0"><i class="bi bi-calendar3 me-1"></i><%= event.formattedDate %></p>
            </div>

            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted">Ticket price</span>
              <span class="text-white fw-bold">₹<%= event.price.toFixed(2) %></span>
            </div>
            <div class="d-flex justify-content-between mb-2">
              <span class="text-muted">Convenience fee</span>
              <span class="text-white fw-bold">₹20.00</span>
            </div>
            <div class="d-flex justify-content-between pb-3 border-bottom border-secondary mb-3">
              <span class="text-muted">Tax (GST 18%)</span>
              <% const tax = event.price * 0.18; %>
              <span class="text-white fw-bold">₹<%= tax.toFixed(2) %></span>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
              <h5 class="fw-bold text-white mb-0">Total Due</h5>
              <% const total = event.price + 20 + tax; %>
              <h3 class="fw-bold text-glow text-success mb-0">₹<%= total.toFixed(2) %></h3>
            </div>

            <div class="alert alert-secondary bg-secondary-glow border-secondary p-3 small text-muted mb-0">
              <i class="bi bi-info-circle-fill me-2 text-primary"></i>
              This checkout is a simulation. No real money or credentials will be processed. You can enter any 16-digit card number, valid expiration date, and CVV to complete the registration.
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const cardholderInput = document.getElementById('cardholderName');
    const cardNumberInput = document.getElementById('cardNumber');
    const expiryInput = document.getElementById('cardExpiry');
    const cvvInput = document.getElementById('cardCvv');
    const payBtn = document.getElementById('pay-btn');
    const payBtnText = document.getElementById('pay-btn-text');
    const spinnerLoader = document.getElementById('spinner-loader');
    const paymentForm = document.getElementById('payment-form');

    const previewName = document.getElementById('preview-cardholder');
    const previewNumber = document.getElementById('preview-card-number');
    const previewExpiry = document.getElementById('preview-expiry');

    // Sync input to Card Preview
    cardholderInput.addEventListener('input', function(e) {
      previewName.textContent = e.target.value.trim() ? e.target.value.toUpperCase() : 'JOHN DOE';
    });

    // Formatting Card Number: xxxx xxxx xxxx xxxx
    cardNumberInput.addEventListener('input', function(e) {
      let raw = e.target.value.replace(/\s+/g, '').replace(/[^0-9]/gi, '');
      let formatted = '';
      for (let i = 0; i < raw.length; i++) {
        if (i > 0 && i % 4 === 0) {
          formatted += ' ';
        }
        formatted += raw[i];
      }
      e.target.value = formatted;

      let display = formatted;
      const maskLen = 19 - formatted.length;
      if (maskLen > 0) {
        for (let i = formatted.length; i < 19; i++) {
          if (i > 0 && (i === 4 || i === 9 || i === 14)) {
            display += ' ';
          } else {
            display += '•';
          }
        }
      }
      previewNumber.textContent = display;
    });

    // Formatting Card Expiry: MM/YY
    expiryInput.addEventListener('input', function(e) {
      let raw = e.target.value.replace(/[^0-9]/gi, '');
      if (raw.length > 2) {
        e.target.value = raw.slice(0, 2) + '/' + raw.slice(2, 4);
      } else {
        e.target.value = raw;
      }
      previewExpiry.textContent = e.target.value || 'MM/YY';
    });

    // Handle Mock Processing on form submission
    paymentForm.addEventListener('submit', function(e) {
      e.preventDefault();

      // Basic client-side checks
      if (cardNumberInput.value.length < 19) {
        alert('Please enter a valid 16-digit card number.');
        return;
      }
      if (expiryInput.value.length < 5) {
        alert('Please enter a valid expiration date (MM/YY).');
        return;
      }
      if (cvvInput.value.length < 3) {
        alert('Please enter a valid 3-digit CVV code.');
        return;
      }

      // Show processing loading animation
      payBtn.disabled = true;
      spinnerLoader.classList.remove('d-none');
      payBtnText.textContent = 'Processing Payment...';

      // Delayed submit to simulate payment gateway call (1.5 seconds delay)
      setTimeout(function() {
        paymentForm.submit();
      }, 1500);
    });
  });
</script>

<%- include('../layouts/footer') %>
